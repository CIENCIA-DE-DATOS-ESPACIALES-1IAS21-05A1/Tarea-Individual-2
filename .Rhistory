gpklink="https://github.com/CIENCIA-DE-DATOS-ESPACIALES-1IAS21-05A1/Tarea-Individual-2/raw/main/seattle.gpkg"
library(sf)
library(ggplot2)
# =========================================================================
# CARGAR TODAS LAS CAPAS DESDE EL GEOPACKAGE (Usando gpklink)
# =========================================================================
base               = read_sf(gpklink, layer = "avenidas_aptas")
escuelas           = read_sf(gpklink, layer = "escuelas")
buenas_ubicaciones = read_sf(gpklink, layer = "buenas_ubicaciones")
malas_ubicaciones  = read_sf(gpklink, layer = "malas_ubicaciones")
nuevas_terreno     = read_sf(gpklink, layer = "nuevas_propuestas_terreno")
nuevas_centro      = read_sf(gpklink, layer = "nuevas_propuestas_centro")
# =========================================================================
# MAPA 1: Estaciones Bien Ubicadas
# =========================================================================
map1gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
# Metemos el nombre dentro de aes(color = "...")
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = buenas_ubicaciones, aes(color = "Estaciones Correctas"), size = 2) +
# Asignamos los colores reales a los nombres
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "#4AA3DF",
"Estaciones Correctas" = "green")) +
ggtitle("Estaciones de Gasolina con Ubicación Correcta") +
theme(legend.position = "right")
map1gg
saveRDS(map1gg, file='map1_buenas.rds')
# =========================================================================
# MAPA 2: Estaciones a Reubicar (En Conflicto)
map2gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 2.5) +
geom_sf(data = malas_ubicaciones, aes(color = "A Reubicar"), shape = 4, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "#4A90A4",
"A Reubicar" = "red")) +
ggtitle("Estaciones de Gasolina en Conflicto") +
theme(legend.position = "right")
map2gg
map2gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 2.5) +
geom_sf(data = malas_ubicaciones, aes(color = "A Reubicar"), shape = 4, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "#4A90A4",
"A Reubicar" = "red")) +
ggtitle("Estaciones de Gasolina en Conflicto") +
theme(legend.position = "right")
map2gg
saveRDS(map2gg, file='map2_malas.rds')
# =========================================================================
map3gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = nuevas_terreno, aes(color = "Nuevos Terrenos"), fill = NA) +
geom_sf(data = nuevas_centro, aes(color = "Nuevos Centros"), shape = 3, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "green",
"Nuevos Terrenos" = "red",
"Nuevos Centros" = "red")) +
ggtitle("Nuevas Ubicaciones Propuestas") +
theme(legend.position = "right")
map3gg
map3gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = nuevas_terreno, aes(color = "Nuevos Terrenos"), fill = NA) +
geom_sf(data = nuevas_centro, aes(color = "Nuevos Centros"), shape = 3, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "green",
"Nuevos Terrenos" = "red",
"Nuevos Centros" = "red")) +
ggtitle("Nuevas Ubicaciones Propuestas") +
theme(legend.position = "right")
map3gg
saveRDS(map3gg, file='map3_propuestas.rds')
map4gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") + # Avenidas de fondo sin leyenda para no saturar
geom_sf(data = nuevas_terreno, aes(color = "Zonas Propuestas"), fill = NA) +
geom_sf(data = nuevas_centro, aes(color = "Nuevas Ubicaciones"), shape = 3, size = 2, stroke = 1.2) +
geom_sf(data = buenas_ubicaciones, aes(color = "Bien Ubicadas"), size = 2) +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = malas_ubicaciones, aes(color = "A Reubicar"), shape = 4, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Zonas Propuestas" = "red",
"Nuevas Ubicaciones" = "red",
"Bien Ubicadas" = "#4AA3DF",
"Escuelas" = "green",
"A Reubicar" = "magenta")) +
ggtitle("Plan de Reubicación de Estaciones de Gasolina en Seattle") +
theme(legend.position = "right") # Manda la leyenda a la derecha
map4gg
map4gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") + # Avenidas de fondo sin leyenda para no saturar
geom_sf(data = nuevas_terreno, aes(color = "Zonas Propuestas"), fill = NA) +
geom_sf(data = nuevas_centro, aes(color = "Nuevas Ubicaciones"), shape = 3, size = 2, stroke = 1.2) +
geom_sf(data = buenas_ubicaciones, aes(color = "Bien Ubicadas"), size = 2) +
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = malas_ubicaciones, aes(color = "A Reubicar"), shape = 4, size = 3, stroke = 1.5) +
scale_color_manual(name = "Simbología",
values = c("Zonas Propuestas" = "red",
"Nuevas Ubicaciones" = "red",
"Bien Ubicadas" = "#4AA3DF",
"Escuelas" = "green",
"A Reubicar" = "magenta")) +
ggtitle("Plan de Reubicación de Estaciones de Gasolina en Seattle") +
theme(legend.position = "right") # Manda la leyenda a la derecha
map4gg
saveRDS(map4gg, file='map4_completo.rds')
setwd("~/GitHub/Tarea-Individual-2")
