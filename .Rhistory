gpklink="https://github.com/CIENCIA-DE-DATOS-ESPACIALES-1IAS21-05A1/Tarea-Individual-2/raw/main/seattle.gpkg"
library(sf)
library(ggplot2)
# =========================================================================
# CARGAR TODAS LAS CAPAS DESDE EL GEOPACKAGE (Usando gpklink)
# =========================================================================
base               = read_sf(gpklink, layer = "avenidas_aptas")
escuelas           = read_sf(gpklink, layer = "escuelas")
buenas_ubicaciones = read_sf(gpklink, layer = "buenas_ubicaciones")
malas_ubicaciones  = read_sf(gpklink, layer = "malas_ubicaciones")
nuevas_terreno     = read_sf(gpklink, layer = "nuevas_propuestas_terreno")
nuevas_centro      = read_sf(gpklink, layer = "nuevas_propuestas_centro")
# =========================================================================
# MAPA 1: Estaciones Bien Ubicadas
# =========================================================================
map1gg = ggplot() +
theme_void() +
geom_sf(data = base, color = "lightgrey") +
# Metemos el nombre dentro de aes(color = "...")
geom_sf(data = escuelas, aes(color = "Escuelas"), size = 1.5) +
geom_sf(data = buenas_ubicaciones, aes(color = "Estaciones Correctas"), size = 2) +
# Asignamos los colores reales a los nombres
scale_color_manual(name = "Simbología",
values = c("Escuelas" = "#4AA3DF",
"Estaciones Correctas" = "green")) +
ggtitle("Estaciones de Gasolina con Ubicación Correcta") +
theme(legend.position = "right")
map1gg
saveRDS(map1gg, file='map1_buenas.rds')
